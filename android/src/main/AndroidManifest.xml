<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives HMS Push Kit token updates (see Push.kt). Inert on builds without HMS Core. -->
    <service
      android:name="expo.modules.huawei.HuaweiPushService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.huawei.push.action.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
